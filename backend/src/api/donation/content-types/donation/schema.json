{
  "kind": "collectionType",
  "collectionName": "donations",
  "info": {
    "singularName": "donation",
    "pluralName": "donations",
    "displayName": "Donation",
    "description": "Registro de donaciones recibidas"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "amount": {
      "type": "string"
    },
    "destination": {
      "type": "enumeration",
      "enum": ["Diezmos", "Ofrendas"],
      "default": "Ofrendas"
    },
    "frequency": {
      "type": "enumeration",
      "enum": ["normal", "semanal", "quincenal", "mensual"],
      "default": "normal"
    },
    "paymentMethod": {
      "type": "enumeration",
      "enum": ["paypal", "transferencia"],
      "default": "transferencia"
    },
    "status": {
      "type": "enumeration",
      "enum": ["pendiente", "completada", "cancelada"],
      "default": "pendiente"
    }
  }
}
