# ===========================================
# Reweb - Strapi + PostgreSQL (Portainer)
# ===========================================

# PostgreSQL
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=CHANGE_ME_strong_password_here

# Strapi Secrets (generate with: openssl rand -base64 16)
APP_KEYS=key1==,key2==,key3==,key4==
API_TOKEN_SALT=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
TRANSFER_TOKEN_SALT=CHANGE_ME
JWT_SECRET=CHANGE_ME

# Environment
NODE_ENV=production
STRAPI_ADMIN_CLIENT_URL=https://strapi.tudominio.com
